---
import { HOME, homeUrl } from '../lib/paths';

const destination = homeUrl(Astro.site);
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
		<meta http-equiv="refresh" content={`0; url=${destination}`} />
		<link rel="canonical" href={destination} />
		<title>Redirigiendo… | Psicología con Maria Acevedo</title>
		<script is:inline define:vars={{ home: destination }}>
			location.replace(home);
		</script>
	</head>
	<body>
		<p><a href={destination}>Ir a la página de inicio</a></p>
	</body>
</html>
