<div class="min-lang-switcher" role="group" aria-label="Seleccionar idioma">
	<button
		type="button"
		class="min-lang-btn is-active"
		data-lang="es"
		aria-label="Español"
		aria-pressed="true"
		title="Español"
	>
		<svg class="min-lang-flag" width="100%" height="100%" viewBox="0 0 36 24" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
			<rect width="36" height="24" fill="#c60b1e"></rect>
			<rect width="36" height="12" y="6" fill="#ffc400"></rect>
		</svg>
	</button>
	<button
		type="button"
		class="min-lang-btn"
		data-lang="en"
		aria-label="English"
		aria-pressed="false"
		title="English"
	>
		<svg class="min-lang-flag" width="100%" height="100%" viewBox="0 0 60 30" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
			<rect width="60" height="30" fill="#012169"></rect>
			<path d="M0 0 60 30M60 0 0 30" stroke="#fff" stroke-width="6"></path>
			<path d="M0 0 60 30M60 0 0 30" stroke="#c8102e" stroke-width="3"></path>
			<path d="M30 0v30M0 15h60" stroke="#fff" stroke-width="10"></path>
			<path d="M30 0v30M0 15h60" stroke="#c8102e" stroke-width="6"></path>
		</svg>
	</button>
</div>
