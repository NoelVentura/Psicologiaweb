<button
	type="button"
	class="min-theme-toggle"
	data-min-theme-toggle
	aria-label="Activar modo oscuro"
>
	<svg
		class="min-theme-toggle__icon min-theme-toggle__icon--moon"
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="none"
		aria-hidden="true"
	>
		<path
			d="M21 14.5A8.5 8.5 0 0 1 9.5 3 7 7 0 1 0 21 14.5Z"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"></path>
	</svg>
	<svg
		class="min-theme-toggle__icon min-theme-toggle__icon--sun"
		width="20"
		height="20"
		viewBox="0 0 24 24"
		fill="none"
		aria-hidden="true"
	>
		<circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
		<path
			d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"></path>
	</svg>
</button>

<script is:inline>
	(function () {
		function syncThemeToggleLabel() {
			var btn = document.querySelector('[data-min-theme-toggle]');
			if (!btn) return;
			var dark = document.documentElement.getAttribute('data-theme') === 'dark';
			btn.setAttribute('aria-label', dark ? 'Activar modo claro' : 'Activar modo oscuro');
		}

		function bindThemeToggle() {
			document.querySelectorAll('[data-min-theme-toggle]').forEach(function (btn) {
				if (btn.dataset.bound) return;
				btn.dataset.bound = 'true';
				btn.addEventListener('click', function () {
					var dark = document.documentElement.getAttribute('data-theme') === 'dark';
					if (dark) {
						document.documentElement.removeAttribute('data-theme');
						localStorage.setItem('min-theme', 'light');
					} else {
						document.documentElement.setAttribute('data-theme', 'dark');
						localStorage.setItem('min-theme', 'dark');
					}
					syncThemeToggleLabel();
				});
			});
			syncThemeToggleLabel();
		}

		bindThemeToggle();
		document.addEventListener('astro:page-load', bindThemeToggle);
	})();
</script>
