---
import { getCategoryBySlug } from '../../data/categories';

interface Props {
	title: string;
	href: string;
	image: string;
	categorySlug: string;
	tag?: string;
}

const { title, href, image, categorySlug, tag = 'Artículo' } = Astro.props;
const category = getCategoryBySlug(categorySlug);
const shortTitle = title.length > 48 ? `${title.slice(0, 48)}…` : title;
---

<article class="aw-product-card">
	<a href={href} class="aw-product-card__link">
		<div class="aw-product-card__media">
			<img src={image} alt="" loading="lazy" width="300" height="240" />
		</div>
		<div class="aw-product-card__head">
			<div>
				<p class="aw-product-card__brand">{category?.label ?? 'Psicología'}</p>
				<p class="aw-product-card__code">{tag}</p>
				<h3 class="aw-product-card__title">{shortTitle}</h3>
			</div>
			<span class="aw-product-card__dot" aria-hidden="true"></span>
		</div>
		<div class="aw-product-card__foot">
			<span>Leer</span>
			<span>→</span>
		</div>
	</a>
</article>

<style>
	.aw-product-card {
		flex: 0 0 auto;
		width: min(58vw, 220px);
		scroll-snap-align: start;
		border: 1px solid var(--aw-border);
		border-radius: 0.75rem;
		background: var(--aw-surface);
		padding: 0.75rem;
		transition: border-color 0.3s, background 0.3s;
	}

	@media (min-width: 1024px) {
		.aw-product-card {
			width: auto;
		}
	}

	.aw-product-card:hover {
		border-color: rgba(255, 255, 255, 0.12);
		background: var(--aw-card);
	}

	.aw-product-card__link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.aw-product-card__media {
		position: relative;
		aspect-ratio: 1.25;
		overflow: hidden;
		border-radius: 0.5rem;
		background: var(--aw-card);
	}

	.aw-product-card__media img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.5s;
	}

	.aw-product-card:hover .aw-product-card__media img {
		transform: scale(1.04);
	}

	.aw-product-card__brand {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.15em;
		color: var(--aw-muted-dim);
		margin: 1rem 0 0.25rem;
	}

	.aw-product-card__code {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		color: var(--aw-accent);
		margin: 0;
	}

	.aw-product-card__title {
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 600;
		line-height: 1.25;
		color: var(--aw-text);
		margin: 0.35rem 0 0;
	}

	.aw-product-card__head {
		display: flex;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.aw-product-card__dot {
		width: 6px;
		height: 6px;
		border-radius: 50%;
		background: var(--aw-accent);
		margin-top: 1.25rem;
		flex-shrink: 0;
	}

	.aw-product-card__foot {
		display: flex;
		justify-content: space-between;
		margin-top: 0.75rem;
		padding-top: 0.65rem;
		border-top: 1px solid rgba(255, 255, 255, 0.06);
		font-family: var(--font-mono);
		font-size: 0.625rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--aw-muted-dim);
	}
</style>
