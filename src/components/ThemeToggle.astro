<button
	type="button"
	class="theme-toggle"
	data-theme-toggle
	aria-label="Cambiar entre modo oscuro y claro"
>
	<span class="theme-toggle__label theme-toggle__label--to-light">Claro</span>
	<span class="theme-toggle__label theme-toggle__label--to-dark">Oscuro</span>
</button>

<script>
	const STORAGE_KEY = 'theme';
	const DEFAULT_THEME = 'semi';

	function applyTheme(theme: 'semi' | 'light' | 'dark') {
		document.documentElement.setAttribute('data-theme', theme);
		localStorage.setItem(STORAGE_KEY, theme);
	}

	document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
		const current = document.documentElement.getAttribute('data-theme') || DEFAULT_THEME;
		const next = current === 'light' ? 'semi' : 'light';
		applyTheme(next);
	});
</script>

<style>
	.theme-toggle {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 4.25rem;
		height: 2.25rem;
		padding: 0 0.75rem;
		border: 1px solid var(--color-border);
		border-radius: 2px;
		background: var(--color-surface);
		cursor: pointer;
		font: inherit;
		font-size: 0.8125rem;
		color: var(--color-muted);
		flex-shrink: 0;
		transition:
			color 0.15s,
			border-color 0.15s;
	}

	.theme-toggle:hover {
		color: var(--color-text);
		border-color: var(--color-muted);
	}

	.theme-toggle__label--to-light {
		display: none;
	}

	:global([data-theme='light']) .theme-toggle__label--to-light {
		display: inline;
	}

	:global([data-theme='light']) .theme-toggle__label--to-dark {
		display: none;
	}

	:global([data-theme='semi']) .theme-toggle__label--to-light,
	:global([data-theme='dark']) .theme-toggle__label--to-light {
		display: none;
	}

	:global([data-theme='semi']) .theme-toggle__label--to-dark,
	:global([data-theme='dark']) .theme-toggle__label--to-dark {
		display: inline;
	}
</style>
